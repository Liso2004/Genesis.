  questions:
  - id: sealed-ruin
    text: You discover a sealed ruin that the town avoids. What interests you first?
    answers:
    - text: What may be hidden inside.
      weights:
      - trait: 7
        weight: 2
      - trait: 4
        weight: 1
    - text: Why someone sealed it.
      weights:
      - trait: 0
        weight: 2
      - trait: 1
        weight: 1
    - text: What preparation an expedition would need.
      weights:
      - trait: 6
        weight: 2
      - trait: 2
        weight: 1
  - id: threatened-stranger
    text: Someone stronger threatens a stranger. What is your first instinct?
    answers:
    - text: Step between them.
      weights:
      - trait: 3
        weight: 2
      - trait: 4
        weight: 1
    - text: Observe what is happening before acting.
      weights:
      - trait: 0
        weight: 2
      - trait: 1
        weight: 1
    - text: Find someone who can help.
      weights:
      - trait: 2
        weight: 2
      - trait: 3
        weight: 1
  - id: unknown-object
    text: You receive an object nobody understands. What do you do?
    answers:
    - text: Study its details.
      weights:
      - trait: 7
        weight: 2
      - trait: 6
        weight: 1
    - text: Try a careful experiment.
      weights:
      - trait: 5
        weight: 2
      - trait: 4
        weight: 1
    - text: Ask someone with relevant knowledge.
      weights:
      - trait: 2
        weight: 2
      - trait: 7
        weight: 1
  - id: journey
    text: You have a day to reach a distant settlement. Which route appeals to you?
    answers:
    - text: An unfamiliar shortcut.
      weights:
      - trait: 4
        weight: 2
      - trait: 8
        weight: 1
    - text: A reliable road with time to prepare.
      weights:
      - trait: 6
        weight: 2
      - trait: 1
        weight: 1
    - text: A route with interesting landmarks.
      weights:
      - trait: 0
        weight: 2
      - trait: 7
        weight: 1
  - id: shared-task
    text: A group has more work than daylight. How do you contribute?
    answers:
    - text: Help coordinate the work.
      weights:
      - trait: 2
        weight: 2
      - trait: 6
        weight: 1
    - text: Find a more efficient method.
      weights:
      - trait: 5
        weight: 2
      - trait: 1
        weight: 1
    - text: Assist whoever is struggling.
      weights:
      - trait: 3
        weight: 2
      - trait: 0
        weight: 1
  - id: setback
    text: Your first attempt at a difficult task fails. What draws you onward?
    answers:
    - text: Finding a different explanation.
      weights:
      - trait: 5
        weight: 2
      - trait: 7
        weight: 1
    - text: Practicing the difficult part.
      weights:
      - trait: 6
        weight: 2
      - trait: 1
        weight: 1
    - text: Trying another route to the goal.
      weights:
      - trait: 4
        weight: 2
      - trait: 8
        weight: 1
